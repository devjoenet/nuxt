{
  "private": true,
  "type": "module",
  "name": "nuxt",
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "build": "vp build && vp build --ssr",
    "dev": "vp dev",
    "check": "vp check && yarn lint:check && yarn format:check && yarn typecheck",
    "audit:production": "yarn npm audit --recursive --environment production --severity high --no-deprecations",
    "audit:full": "yarn npm audit --recursive --severity high --no-deprecations",
    "format": "prettier --write resources/",
    "format:check": "prettier --check resources/",
    "lint": "eslint . --fix && yarn test:frontend-architecture",
    "lint:check": "eslint . && yarn test:frontend-architecture",
    "test:frontend-architecture": "node --test tests/Frontend/eslint-architecture.test.mjs",
    "typecheck": "vue-tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/ph": "^1.2.2",
    "@inertiajs/vite": "^3.7.0",
    "@laravel/vite-plugin-wayfinder": "^0.1.7",
    "@shufo/prettier-plugin-blade": "^1.16.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plus": "0.3.0",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@inertiajs/vue3": "^3.7.0",
    "@internationalized/date": "^3.12.3",
    "@nuxt/ui": "^4.11.0",
    "@phosphor-icons/vue": "^2.2.1",
    "@unovis/ts": "^1.6.7",
    "@unovis/vue": "^1.6.7",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "laravel-vite-plugin": "^3.2.0",
    "maplibre-gl": "^6.6.0",
    "motion-v": "^2.4.0",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.42",
    "vue-currency-input": "^3.2.2",
    "zod": "^4.5.4"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.63.1",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "lightningcss-linux-x64-gnu": "^1.33.0"
  },
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "core-js-pure@3.49.0": true,
    "maplibre-gl@6.6.0": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "esbuild@0.28.1": true
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
