{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "devjoenet/nuxt",
  "type": "project",
  "description": "Southeast Code's Laravel 13 and Inertia operating workspace for practical CRM and operations workflows.",
  "keywords": [
    "laravel",
    "vue",
    "inertia",
    "nuxt-ui",
    "tailwind",
    "typescript"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "inertiajs/inertia-laravel": "^3.5.1",
    "laravel/fortify": "^1.41",
    "laravel/framework": "^13.35.0",
    "laravel/horizon": "^5.50.0",
    "laravel/tinker": "^3.0.2",
    "laravel/wayfinder": "^0.1.23",
    "league/flysystem-aws-s3-v3": "^3.35.3",
    "spatie/laravel-activitylog": "^5.1.1",
    "spatie/laravel-data": "^4.23",
    "spatie/laravel-permission": "^8.3"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24.1",
    "larastan/larastan": "^3.13.0",
    "laravel/boost": "^2.10.3",
    "laravel/pail": "^1.2.7",
    "laravel/pao": "^1.1.5",
    "laravel/pint": "^1.32.1",
    "laravel/sail": "^1.68",
    "mockery/mockery": "^1.6.15",
    "nunomaduro/collision": "^8.9.5",
    "pestphp/pest": "^4.7.8",
    "pestphp/pest-plugin-browser": "^4.3.1",
    "pestphp/pest-plugin-laravel": "^4.1",
    "pestphp/pest-plugin-type-coverage": "^4.0.4",
    "rector/rector": "^2.7.0",
    "spatie/boost-spatie-guidelines": "^1.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi",
      "yarn install --immutable",
      "yarn build"
    ],
    "update:requirements": [
      "Composer\\Config::disableProcessTimeout",
      "@composer update --with-all-dependencies --no-interaction",
      "@composer bump --no-interaction",
      "corepack yarn update:requirements",
      "@php artisan boost:update --no-interaction"
    ],
    "setup": [
      "composer install",
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan key:generate",
      "@php artisan migrate --force",
      "yarn install --immutable",
      "yarn build"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "@php artisan dev"
    ],
    "format": [
      "pint --parallel",
      "corepack yarn format"
    ],
    "lint": [
      "rector",
      "pint --parallel",
      "yarn lint"
    ],
    "test:type-coverage": "pest --type-coverage --min=100",
    "coverage": "herd coverage ./vendor/bin/pest",
    "test:types:max": "phpstan --configuration=phpstan.max.neon --memory-limit=512M",
    "test:lint": [
      "pint --parallel --test",
      "rector --dry-run",
      "yarn format:check"
    ],
    "test:browser": "pest --testsuite=Browser --parallel --processes=2 --compact",
    "test:unit": [
      "@php artisan config:clear --ansi",
      "pest --testsuite=Unit,Feature --parallel --coverage --min=80.0"
    ],
    "test:types": "phpstan --memory-limit=512M",
    "test": [
      "@test:type-coverage",
      "@test:unit",
      "@test:browser",
      "@test:lint",
      "@test:types",
      "@test:types:max"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
